{
  "manifest_version": 3,
  "name": "PLabs Privacy Wallet",
  "short_name": "PLabs Wallet",
  "version": "0.8.1",
  "description": "Self-custodial EVM wallet with an embedded PLabs privacy asset engine.",
  "icons": {
    "16": "icons/plabs-16.png",
    "32": "icons/plabs-32.png",
    "48": "icons/plabs-48.png",
    "128": "icons/plabs-128.png"
  },
  "minimum_chrome_version": "127",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PLabs Privacy Wallet",
    "default_icon": {
      "16": "icons/plabs-16.png",
      "24": "icons/plabs-24.png",
      "32": "icons/plabs-32.png",
      "48": "icons/plabs-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://app.plabs.online/*",
    "https://monad-indexer.plabs.online/*",
    "https://monad-relayer.plabs.online/*",
    "https://eth-indexer.plabs.online/*",
    "https://eth-relayer.plabs.online/*",
    "https://portal.sqd.dev/*",
    "https://rpc.monad.xyz/*",
    "https://rpc-mainnet.monadinfra.com/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://eth.drpc.org/*",
    "https://rpc.flashbots.net/*",
    "https://1rpc.io/eth/*",
    "https://base-rpc.publicnode.com/*",
    "https://mainnet.base.org/*",
    "https://arbitrum-one-rpc.publicnode.com/*",
    "https://arb1.arbitrum.io/rpc/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  }
}
