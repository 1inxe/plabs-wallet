{
  "name": "@plabs-wallet/sdk",
  "version": "0.4.1",
  "description": "Typed dApp SDK for the PLabs EVM privacy wallet browser extension",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./chains/evm": {
      "import": {
        "types": "./dist/esm/chains/evm/index.d.ts",
        "default": "./dist/esm/chains/evm/index.js"
      },
      "require": {
        "types": "./dist/cjs/chains/evm/index.d.ts",
        "default": "./dist/cjs/chains/evm/index.js"
      }
    },
    "./chains/privacy": {
      "import": {
        "types": "./dist/esm/chains/privacy/index.d.ts",
        "default": "./dist/esm/chains/privacy/index.js"
      },
      "require": {
        "types": "./dist/cjs/chains/privacy/index.d.ts",
        "default": "./dist/cjs/chains/privacy/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.upstream",
    "NOTICE.md",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": [
    "plabs",
    "privacy",
    "wallet",
    "evm",
    "eip-1193",
    "eip-6963",
    "perc20"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "plabsFork": {
    "upstream": "https://github.com/NoirWallet/noir-wallet-sdk",
    "version": "0.1.9",
    "commit": "19e0aec93187e1679e1cbb44b2cd825a8c0a1662"
  }
}
